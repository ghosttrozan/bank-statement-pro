# ── SERVER CONFIG ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE CONFIG ────────────────────────────────────────────
# Local development MongoDB URL (or Atlas MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/statementpro

# ── SECURITY & JWT ─────────────────────────────────────────────
# Set unique, long, random secret keys in production (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_make_it_long_and_random_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_make_it_long_and_random_67890
JWT_ACCESS_EXPIRY=15m

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── SEED INITIAL SUPER ADMIN (Runs once on npm run seed) ─────
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=Admin@12345
